class_name TSCritterBios
extends RefCounted

## A line about each critter, shown in the Collection's card when one is
## tapped. Keyed by name (TSProfile.CRITTERS); a critter added without one
## gets FALLBACK. Kept short: the card's column is narrow.

const FALLBACK := "A brand-new friend. Nobody knows much about them yet!"

const BIOS := {
	"Blu": "The first critter out of the first egg. Still a little wobbly.",
	"Gardy": "Talks to every plant in the camp. The plants seem to listen.",
	"Ghosty": "Says boo, then says sorry. Very polite, for a ghost.",
	"Ginger": "Smells like cookies wherever it goes. Nobody minds.",
	"Goldie": "Shines so bright it doubles as the camp's night light.",
	"Grad": "Just finished school and wants to tell you all about it.",
	"Granny": "Knits a scarf for anyone who stands still long enough.",
	"Grandpa": "Has a story about every rock on this planet. Every single one.",
	"Sprout": "Grows a tiny bit taller every time it rains.",
	"Skater": "Does tricks off the ship's ramp. Lands most of them.",
	"King": "Rules the camp, mostly by deciding what's for lunch.",
	"Smooch": "Gives out kisses whether you asked or not.",
	"Knight": "Sworn to protect the camp from spiders and bad moods.",
	"Knitter": "Has never met a ball of yarn it couldn't turn into a hat.",
	"Postie": "Delivers every letter on time, even the ones to the moon.",
	"Mermaid": "Visits from the pond to trade shells for snacks.",
	"Mama": "Makes sure everyone eats breakfast. No exceptions.",
	"Rawr": "Very scary. Ask it, it'll tell you. Rawr.",
	"Popcorn": "Pops up out of nowhere, usually during the good part.",
	"Nurse": "Has a bandage and a hug for every scraped knee.",
	"Panda": "Naps twice a day. Three times on a good day.",
	"Pie": "Always warm, always sweet, always asking for seconds.",
	"Dino": "Totally not extinct. It just likes to keep a low profile.",
	"Director": "Yells 'Action!' at sunrise. Every sunrise.",
	"Doc": "Checks everyone's heartbeat. Says they all sound happy.",
	"Puppy": "Fetches anything you throw. Also things you didn't throw.",
	"Donkey": "Carries the heavy crates and never complains. Much.",
	"Donut": "Sweet on the outside, sweeter in the middle.",
	"Dragon": "Toasts the best marshmallows in the galaxy.",
	"Elf": "Wraps presents faster than you can unwrap them.",
	"Fairy": "Sprinkles glitter on things. Some of it never comes off.",
	"Autumn": "Loves crunchy leaves and cozy sweaters.",
	"Firework": "Gets very excited, very loudly, very sparkly.",
	"Capy": "So calm that birds sit on its head to rest.",
	"Kitty": "Sits in every box that lands near the camp.",
	"Chick": "Fresh out of its shell and already chirping orders.",
	"Choco": "Melts a little on sunny days. Worth it.",
	"Cocoa": "Best enjoyed by the campfire with a blanket.",
	"Cinnamon": "Spicy on the outside, a sweetheart on the inside.",
	"Scrubby": "Keeps the ship spotless. Do NOT track mud in.",
	"Builder": "Can fix anything with three nails and a smile.",
	"Moo": "Gives the best advice, as long as it's about grass.",
	"Cupid": "Never misses. Everyone in camp is a little bit in love.",
	"Gent": "Tips its hat to everyone, even the rocks.",
	"Artist": "Painted the camp's sunset. The real one was jealous.",
	"Baby": "Small, sleepy and the boss of everyone.",
	"Chef": "Cooks up a feast from whatever's in the garden.",
	"Biker": "Zooms round the camp in loops. Waves every lap.",
	"Explorer": "Has mapped half the planet. Lost the map twice.",
	"Party": "Brought snacks, music and confetti. Always.",
	"Buff": "Lifts the ship's crates for a warm-up.",
	"Camo": "You probably can't see it. It's right next to you.",
	"Camper": "Pitched the camp's very first tent. Still proud of it.",
	"Pirate": "Hunting for treasure. Has found mostly pebbles.",
	"Imp": "A little bit of trouble in a very small package.",
	"Shadow": "Quiet, mysterious and secretly very cuddly.",
	"Flurry": "Brings a tiny snowfall wherever it goes.",
	"Witch": "Brews potions that mostly turn things purple.",
	"Wizard": "Knows one spell really well. It makes bubbles.",
	"Wrench": "Tightens every bolt on the ship, twice for luck.",
	"Mayor": "Holds a camp meeting every morning. Attendance: itself.",
	"Boss": "In charge. Of what, nobody is quite sure.",
	"Dentist": "Reminds everyone to brush after s'mores.",
	"Medic": "First on the scene, with a bandage and a lollipop.",
	"Sharky": "All teeth and all smiles. Mostly smiles.",
	"Pearl": "Found at the bottom of the pond, shining like the moon.",
	"Skier": "Would ski down a sand dune if there was no snow.",
	"Sledder": "Goes down every hill it sees. Then up. Then down again.",
	"S'more": "Gooey, toasty and the reason everyone loves the campfire.",
	"Boarder": "Rides anything with a slope. Even the ship's wing.",
	"Snowman": "Wants a hug but is worried about melting.",
	"Frost Queen": "Rules the winter with a sparkle and a snowball.",
	"Blossom": "Blooms a little brighter when you say hello.",
	"Berry": "Small, round and bursting with good ideas.",
	"Sunny": "Never had a bad day. Doesn't plan to start.",
	"Shades": "Too cool for the sun. Wears sunglasses at night too.",
	"Zippy": "Already there. And back. And there again.",
	"Violet": "Shy at first, then it'll tell you its whole life story.",
	"Super Pup": "Saves the day, then asks for a belly rub.",
	"Whiskers": "Knows every secret in camp. Tells none of them.",
	"Surfer": "Rides the pond's tiny waves like they're giants.",
	"Tourist": "Has taken 800 photos of the ship. Wants 800 more.",
	"Turkey": "Gobbles for joy. Gobbles for everything, really.",
	"Drizzle": "Brings its own little cloud. The garden loves it.",
	"Puddles": "Has jumped in every puddle on this planet. Twice.",
	"Bookworm": "Read every book in camp. Started on the labels.",
	"Hood": "Takes a basket of snacks to Grandma every day.",
	"Rosie": "Smells lovely and always remembers your birthday.",
	"Rudy": "Its nose glows brightest on the darkest nights.",
	"Jogger": "Runs round the camp every morning. Waves at everyone.",
	"Sailor": "Has crossed the pond in the rowboat. Twice!",
	"Santa": "Has a list, has checked it twice, and you're on it.",
	"Labby": "Mixes things in tubes until they fizz. Usually on purpose.",
	"Diver": "Explores the bottom of the pond for lost treasure.",
	"Piggy": "Loves mud baths and long naps in the sun.",
	"Pilgrim": "Came a long way to get here, and brought pie.",
	"Captain": "Will fly the ship home the minute it's fixed.",
	"Polar": "Wears its own fur coat and loves the cold.",
	"Groovy": "Moves to music only it can hear.",
	"Patch": "Covered in patches, every one with a story.",
	"Mischief": "If something's missing, check behind Mischief.",
	"Princess": "Royalty, but happy to help carry the logs.",
	"Bunny": "Hops everywhere. Has never once walked.",
	"Rainbow": "Shows up right after the rain, every time.",
}


static func bio(name: String) -> String:
	return str(BIOS.get(name, FALLBACK))
