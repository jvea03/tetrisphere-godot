rules_version = '2';
// Egg Escape's online data (scripts/meta/online.gd; docs/online.md). Paste into
// Firebase console > Firestore Database > Rules and Publish after a change,
// or `firebase deploy --only firestore:rules` from this repo.
//
// A board row is still the four fields the live 1.3.6 apps write
// (name, avatar, stars, t). `t` is the phone's own clock and is not compared
// to the server: a wrong device clock must keep posting. What changed is that
// `stars` has to be a total the board's age can support, and only on a board
// id the game actually uses. tests/board_limits_test.gd repeats this formula.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function okName(n) { return n is string && n.size() >= 1 && n.size() <= 24; }

    // A win pays at most 5 stars (3 hearts + 2 first-try). 8 a minute is a
    // perfect win every 37.5s, faster than a level from 7 on. The burst covers
    // a few wins in one sync; the slack is an hour of clock skew and of a
    // write landing just either side of UTC midnight. Caps are whole-board ceilings.
    function starsPerMin() { return 8; }
    function starBurst() { return 40; }
    function slackSec() { return 3600; }
    function dailyCap() { return 12000; }
    function weeklyCap() { return 15000; }
    function seasonCap() { return 30000; }
    // Snowballs are piece pops, not stars. 180 a minute is 3 a second, with a
    // 2,000 burst for one heavy chain, never past the phone's own 100,000 clamp.
    // The tail is 18h past Monday 00:00 UTC so Sunday night in UTC-12 still posts.
    function snowPerMin() { return 180; }
    function snowBurst() { return 2000; }
    function snowCap() { return 100000; }
    function snowTailSec() { return 64800; }
    // tools/online_check only. The game never reads a check_ board.
    function checkCap() { return 100; }

    function nowSec() { return int(request.time.toMillis() / 1000); }

    function entryShape() {
      return request.resource.data.keys().hasOnly(['name', 'avatar', 'stars', 't'])
        && okName(request.resource.data.name)
        && request.resource.data.avatar is int
        && request.resource.data.avatar >= 0
        && request.resource.data.avatar < 200
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0
        && request.resource.data.t is int;
    }

    // elapsedSec is server-now minus the board's start, so it is negative during
    // the slack before open. inWindow guarantees elapsedSec + slackSec >= 0.
    function capAt(elapsedSec, hardCap) {
      let grown = starBurst() + starsPerMin() * int((elapsedSec + slackSec()) / 60);
      return grown < hardCap ? grown : hardCap;
    }

    function starsAllowed(startSec, endSec, hardCap) {
      return nowSec() + slackSec() >= startSec
        && nowSec() <= endSec + slackSec()
        && request.resource.data.stars <= capAt(nowSec() - startSec, hardCap);
    }

    function dailyStartSec(board) {
      let ymd = board.split('_')[1].split('-');
      return int(timestamp.date(int(ymd[0]), int(ymd[1]), int(ymd[2])).toMillis() / 1000);
    }

    // Week index, Monday 00:00 UTC: the same (utc_day + 3) / 7 the game uses,
    // so this week number's Monday is (w * 7 - 3) days after the epoch.
    function weekStartSec(w) {
      return (w * 7 - 3) * 86400;
    }

    function weekIndex(token) {
      return int(token.replace('^W', ''));
    }

    // Season 1's board starts the day leaderboards opened (2026-11-11), not the
    // Battle Pass calendar's Oct 16. Later seasons are 28 days from 2026-12-01,
    // matching TSProfile's BATTLE_PASS_CALENDAR / BATTLE_PASS_DAYS.
    function seasonStartSec(n) {
      return n <= 1
        ? int(timestamp.date(2026, 11, 11).toMillis() / 1000)
        : int(timestamp.date(2026, 12, 1).toMillis() / 1000) + (n - 2) * 28 * 86400;
    }

    function seasonEndSec(n) {
      return n <= 1
        ? int(timestamp.date(2026, 12, 1).toMillis() / 1000)
        : seasonStartSec(n) + 28 * 86400;
    }

    function snowCapAt(elapsedSec) {
      let grown = snowBurst() + snowPerMin() * int((elapsedSec + slackSec()) / 60);
      return grown < snowCap() ? grown : snowCap();
    }

    function boardAllowed(board) {
      return (board.matches('^daily_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && starsAllowed(dailyStartSec(board), dailyStartSec(board) + 86400, dailyCap()))
        || (board.matches('^weekly_W[0-9]{1,6}$')
          && starsAllowed(weekStartSec(weekIndex(board.split('_')[1])), weekStartSec(weekIndex(board.split('_')[1])) + 7 * 86400, weeklyCap()))
        || (board.matches('^season_S[1-9][0-9]{0,3}$')
          && starsAllowed(seasonStartSec(int(board.split('_')[1].replace('^S', ''))), seasonEndSec(int(board.split('_')[1].replace('^S', ''))), seasonCap()))
        || (board.matches('^snowball_W[0-9]{1,6}_(red|green)$')
          && snowAllowed(board))
        || (board.matches('^check_[A-Za-z0-9_]{1,40}$')
          && request.resource.data.stars <= checkCap());
    }

    // A stored total can stay or rise. A missing or non-integer stars field
    // cannot be patched into a score.
    function keepsStars() {
      return resource.data.keys().hasAll(['stars'])
        && resource.data.stars is int
        && request.resource.data.stars >= resource.data.stars;
    }

    // Thursday 00:00 UTC through Monday 18:00 UTC (end + snowTailSec).
    function snowAllowed(board) {
      let monday = weekStartSec(weekIndex(board.split('_')[1]));
      let startSec = monday + 3 * 86400;
      let endSec = monday + 7 * 86400;
      return nowSec() + slackSec() >= startSec
        && nowSec() <= endSec + snowTailSec()
        && request.resource.data.stars <= snowCapAt(nowSec() - startSec);
    }

    // A board's rows: anyone signed in reads (a rules filter on a query would
    // fail the whole top-50 read). Each player writes only their own row.
    match /boards/{board}/entries/{player} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == player
        && entryShape() && boardAllowed(board);
      allow update: if signedIn() && request.auth.uid == player
        && entryShape() && boardAllowed(board)
        && keepsStars();
      allow delete: if false;
    }

    // Stickers to a player: one per sender (the doc id is the sender), only
    // the sticker ids the game has; the receiver reads and deletes them.
    match /stickers/{to}/got/{from} {
      allow read, delete: if signedIn() && request.auth.uid == to;
      allow create, update: if signedIn() && request.auth.uid == from && from != to
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'sticker', 't'])
        && okName(request.resource.data.name)
        && request.resource.data.avatar is int
        && request.resource.data.sticker in ['angry', 'sad', 'congrats', 'jolly', 'snowman', 'gift', 'cocoa']
        && request.resource.data.t is int;
    }

    // Name reports, for review in the console. Write-only.
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'by', 't']);
      allow read, update, delete: if false;
    }
  }
}
