# Godot's import cache and editor state: rebuilt on open.
.godot/

# Export output and signing credentials never go in the repo.
/build/
/export/
# The Android Gradle build template: reinstalled by tools/release_aab.ps1.
/android/
export_credentials.cfg
*.apk
*.aab
*.ipa
*.keystore

# OS clutter.
.DS_Store
Thumbs.db

# AdMob addon: its downloader cache and the 12 MB iOS binaries (copied from Duckdoku or re-fetched by the addon)
addons/admob/downloads/
addons/admob/ios/bin/

# Recorded ad videos (tools/make_videos.ps1): 60-100 MB each, rebuilt on demand.
/store/ads/video/
# Movie Maker window settings, written and removed by tools/make_videos.ps1.
/override.cfg
# Recorded YouTube Shorts (tools/make_shorts.ps1): 50-130 MB each, rebuilt on demand.
/store/youtube/shorts/

# The EggNotify plugin's Gradle output and SDK path (tools/build_notify_plugin.ps1); the AARs it makes live in addons/EggNotify/bin.
/android_plugins/*/build/
/android_plugins/*/.gradle/
/android_plugins/*/local.properties
# Raw screens for the captioned Play screenshots (tools/store_shot), rebuilt on demand.
/store/screenshots_src/
